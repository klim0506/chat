# Скопируйте в telegram-gluetun.env и подставьте свои значения.
# Секреты не коммитить — telegram-gluetun.env в .gitignore.

# Встроенный HTTP-прокси для backend (порт 8888 внутри сети Docker)
HTTPPROXY=on

# --- Пример: свой WireGuard (custom) — данные из .conf провайдера ---
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=PASTE_YOUR_PRIVATE_KEY
WIREGUARD_ADDRESSES=10.0.0.2/32
WIREGUARD_PUBLIC_KEY=PASTE_SERVER_PUBLIC_KEY
WIREGUARD_ENDPOINT_IP=1.2.3.4
WIREGUARD_ENDPOINT_PORT=51820
# Опционально: WIREGUARD_PRESHARED_KEY=

# --- Альтернатива: готовый провайдер в Gluetun (см. wiki «Providers») ---
# VPN_SERVICE_PROVIDER=nordvpn
# OPENVPN_USER=...
# OPENVPN_PASSWORD=...
