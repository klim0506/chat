# Для прода заполнить извне: VITE_APP_URL, VITE_API_URL, VITE_WS_URL, VITE_WEB_APP_URL
# ─── Заполнить извне (только для деплоя) ─────────────────────────────────
# VITE_APP_URL=
# VITE_API_URL=
# VITE_WS_URL=
# VITE_WEB_APP_URL=
# VITE_MARKETING_HOSTS=   # хосты лендинга через запятую (по умолчанию pingychat.com,www.pingychat.com)
# VITE_ANDROID_APK_URL=   # прямая ссылка на APK, если раздаёте с другого домена

# ─── Остальное (дефолты для разработки) ─────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_WS_URL=
VITE_API_URL=
VITE_WEB_APP_URL=
VITE_LANDING_AT_ROOT=false
VITE_ALPHA_BANNER_ENABLED=false
VITE_CLIENT_TYPE=web
VITE_PWA_INSTALL_ENABLED=false
