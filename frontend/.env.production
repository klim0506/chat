# Production: URLs are empty so the browser uses relative paths.
# Nginx proxies /api → backend:8000 and /ws → backend:8000.
# This avoids CORS entirely and works with any domain over HTTPS.
VITE_API_URL=
VITE_WS_URL=
VITE_PWA_INSTALL_ENABLED=false
# Set to "true" to show alpha-testing disclaimer for logged-in users; "false" to disable
VITE_ALPHA_BANNER_ENABLED=false
