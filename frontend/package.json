{
  "name": "chat-platform-frontend",
  "private": true,
  "version": "1.3.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "optimize:assets": "node ./scripts/optimize-static-assets.mjs",
    "i18n:check": "node ./scripts/check-i18n-coverage.mjs",
    "i18n:allowlist:update": "node ./scripts/check-i18n-coverage.mjs --update-allowlist",
    "build": "npm run optimize:assets && tsc -b && vite build",
    "build:prod": "npm run optimize:assets && vite build",
    "build:landing": "node scripts/build-landing.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "create-fixtures": "node scripts/create-e2e-fixtures.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "tauri": "tauri",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev",
    "ios:init": "tauri ios init",
    "ios:build": "tauri ios build",
    "ios:dev": "tauri ios dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "axios": "^1.6.0",
    "dexie": "^4.3.0",
    "libsodium-wrappers-sumo": "^0.7.13",
    "lottie-web": "^5.12.2",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
