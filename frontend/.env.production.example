# Сборка для прода: приложение на https://web.pingychat.com, лендинг на https://pingychat.com
# Скопировать в .env.production или задать при сборке:
#   VITE_APP_URL=https://web.pingychat.com VITE_LANDING_AT_ROOT=true npm run build

# Базовый URL приложения (canonical, og:url, og:image, JSON-LD в index.html)
VITE_APP_URL=https://web.pingychat.com

# Лендинг на корневом домене (pingychat.com); на web.pingychat.com корень / → редирект в /auth или /chats
VITE_LANDING_AT_ROOT=true

# API/WS по умолчанию — тот же хост (/api, /ws). Если бэкенд на другом домене:
# VITE_API_URL=https://api.pingychat.com
# VITE_WS_URL=wss://api.pingychat.com
