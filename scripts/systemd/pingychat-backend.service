[Unit]
Description=PingyChat Django ASGI (Daphne)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=pingychat
Group=pingychat
WorkingDirectory=/root/chat/backend
EnvironmentFile=/root/chat/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/root/chat/backend/.venv/bin/daphne -b 127.0.0.1 -p 8000 -t 3600 config.asgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
