[Unit]
Description=PingyChat Celery Worker
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=pingychat
Group=pingychat
WorkingDirectory=/root/chat/backend
EnvironmentFile=/root/chat/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/root/chat/backend/.venv/bin/celery -A config worker -l INFO -c 4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
