# ─── Production .env template ─────────────────────────────────────────
# Copy this to backend/.env and fill in real values before deploying.
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Generate MESSAGE_ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

SECRET_KEY=<CHANGE-ME-LONG-RANDOM-KEY>
DEBUG=False

# ─── Domain & hosts ───────────────────────────────────────────────────
# Replace example.com with your actual domain.
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://example.com
CORS_ALLOW_ALL_ORIGINS=False
FRONTEND_URL=https://example.com

# ─── HTTPS security ──────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=True

# ─── Auth ─────────────────────────────────────────────────────────────
AUTH_DEBUG=False
AUTH_DEBUG_PHONES=
AUTH_DEBUG_CODE=
AUTH_SEND_CODE_RATE=5/min

# ─── Encryption ──────────────────────────────────────────────────────
MESSAGE_ENCRYPTION_KEY=<CHANGE-ME-FERNET-KEY>

# ─── Database ─────────────────────────────────────────────────────────
# When using docker-compose.prod.yml, DATABASE_URL is set via environment.
# This line is a fallback / for bare-metal deployment.
USE_SQLITE=False
DATABASE_URL=postgres://postgres:<DB-PASSWORD>@db:5432/chatdb
REDIS_URL=redis://redis:6379/0

# ─── SMS (RedSMS) ────────────────────────────────────────────────────
REDSMS_LOGIN=
REDSMS_API_KEY=
REDSMS_FROM=Chat

# ─── Payments (YooKassa) ─────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ─── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_SECRET=
TELEGRAM_GATEWAY_TOKEN=
