# ─── Production .env template ─────────────────────────────────────────
# Copy this to backend/.env and fill in real values before deploying.
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Generate MESSAGE_ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

SECRET_KEY=<CHANGE-ME-LONG-RANDOM-KEY>
DEBUG=False

# ─── Domain & hosts ───────────────────────────────────────────────────
# App on web.pingychat.com, landing on pingychat.com.
# FRONTEND_URL — база для invite-ссылок (должен быть web-приложение).
ALLOWED_HOSTS=pingychat.com,www.pingychat.com,web.pingychat.com
# Include https://tauri.localhost so the Windows/macOS Tauri app can call the API (cross-origin from WebView).
CSRF_TRUSTED_ORIGINS=https://pingychat.com,https://www.pingychat.com,https://web.pingychat.com,https://tauri.localhost
CORS_ALLOWED_ORIGINS=https://pingychat.com,https://www.pingychat.com,https://web.pingychat.com,https://tauri.localhost
CORS_ALLOW_ALL_ORIGINS=False
FRONTEND_URL=https://web.pingychat.com

# ─── HTTPS security ──────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=True

# ─── Auth ─────────────────────────────────────────────────────────────
AUTH_DEBUG=False
AUTH_DEBUG_PHONES=
AUTH_DEBUG_CODE=
AUTH_SEND_CODE_RATE=5/min

# ─── Encryption ──────────────────────────────────────────────────────
MESSAGE_ENCRYPTION_KEY=<CHANGE-ME-FERNET-KEY>

# ─── Database ─────────────────────────────────────────────────────────
# When using docker-compose.prod.yml, DATABASE_URL is set via environment.
# This line is a fallback / for bare-metal deployment.
USE_SQLITE=False
DATABASE_URL=postgres://postgres:<DB-PASSWORD>@db:5432/chatdb
REDIS_URL=redis://redis:6379/0

# ─── Media storage (uploads, avatars) ─────────────────────────────────
# Store outside project dir. Create dir and set permissions:
#   sudo mkdir -p /var/media/pingychat.com
#   sudo chown www-data:www-data /var/media/pingychat.com
# For remote machine: mount NFS/SMB at this path before starting app.
MEDIA_ROOT=/var/media/pingychat.com
MEDIA_URL=/media/

# ─── SMS (RedSMS) ────────────────────────────────────────────────────
REDSMS_LOGIN=
REDSMS_API_KEY=
REDSMS_FROM=Chat

# ─── Payments (YooKassa) ─────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Webhook: allow only YooKassa IPs (see yookassa.ru/developers/using-api/webhooks). Empty = no filter (not recommended).
# YOOKASSA_WEBHOOK_IP_ALLOWLIST=77.75.153.0/25,185.71.76.0/27

# ─── Telegram Gateway (коды верификации) ───────────────────────────────
# https://gateway.telegram.org/ → Account → API → Copy Token
TELEGRAM_GATEWAY_TOKEN=
# Прокси к gatewayapi (Tor/Gluetun) задаётся в docker-compose.yml при деплое в Docker; здесь не дублируйте без нужды.
