SECRET_KEY=your-secret-key
DEBUG=True

# ─── Hosts & Origins ─────────────────────────────────────────────────
# Dev:  localhost
# Prod: your actual domain (e.g. example.com)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False
FRONTEND_URL=http://localhost:5173
# Prod example:
#   ALLOWED_HOSTS=example.com,www.example.com
#   CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
#   CORS_ALLOWED_ORIGINS=https://example.com
#   FRONTEND_URL=https://example.com

# ─── HTTPS Security ──────────────────────────────────────────────────
# Set to True in production behind nginx with SSL
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False

# ─── Auth ─────────────────────────────────────────────────────────────
AUTH_DEBUG=False
AUTH_DEBUG_PHONES=
AUTH_DEBUG_CODE=

# ─── Database ─────────────────────────────────────────────────────────
# Для разработки без PostgreSQL поставьте USE_SQLITE=True (файл db.sqlite3 в backend/)
USE_SQLITE=True
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatdb
REDIS_URL=redis://localhost:6379/0

# ─── SMS (RedSMS) ────────────────────────────────────────────────────
REDSMS_LOGIN=
REDSMS_API_KEY=
REDSMS_FROM=Chat

# ─── Payments (YooKassa) ─────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ─── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_SECRET=
TELEGRAM_GATEWAY_TOKEN=
