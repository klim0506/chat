# Секреты и ключи — заполнить самому (см. backend/.env.production.example для прода).
# SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# MESSAGE_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ─── Заполнить извне ────────────────────────────────────────────────────
SECRET_KEY=
MESSAGE_ENCRYPTION_KEY=
SUPPORT_PHONE=
REDSMS_LOGIN=
REDSMS_API_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Webhook: allow only these IPs/CIDRs (see yookassa.ru/developers/using-api/webhooks). Empty = no filter.
# YOOKASSA_WEBHOOK_IP_ALLOWLIST=77.75.153.0/25,185.71.76.0/27
TELEGRAM_GATEWAY_TOKEN=
# Прод в Docker: прокси для gatewayapi задаётся в docker-compose.yml (Tor). Локально при блокировках:
# TELEGRAM_GATEWAY_HTTPS_PROXY=socks5h://127.0.0.1:9050

# ─── Остальное (дефолты для разработки) ────────────────────────────────
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False
FRONTEND_URL=http://localhost:5173

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False

AUTH_DEBUG=False
AUTH_DEBUG_PHONES=
AUTH_DEBUG_CODE=

USE_SQLITE=False
DATABASE_URL=postgres://postgres:postgres@localhost:5433/chatdb
REDIS_URL=redis://localhost:6379/0

# Media storage (uploads, avatars). Empty = backend/media (project dir).
# Prod: use external path, e.g. /var/media/pingychat.com
# Remote machine: mount NFS/SMB at that path, or set MEDIA_ROOT to mount point.
# MEDIA_ROOT=/var/media/pingychat.com
# MEDIA_URL=/media/

REDSMS_FROM=Chat
