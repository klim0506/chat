SECRET_KEY=your-secret-key
DEBUG=True

# ─── Hosts & Origins ─────────────────────────────────────────────────
# Dev:  localhost
# Prod: your actual domain (e.g. example.com)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False
FRONTEND_URL=http://localhost:5173
# Prod example:
#   ALLOWED_HOSTS=example.com,www.example.com
#   CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
#   CORS_ALLOWED_ORIGINS=https://example.com
#   FRONTEND_URL=https://example.com

# ─── HTTPS Security ──────────────────────────────────────────────────
# Set to True in production behind nginx with SSL
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False

# ─── Auth ─────────────────────────────────────────────────────────────
# Режим отладки: для номеров из AUTH_DEBUG_PHONES SMS/Telegram не вызываются,
# ввод кода — AUTH_DEBUG_CODE (чтобы не получать 502 на тестовом номере).
AUTH_DEBUG=False
AUTH_DEBUG_PHONES=
AUTH_DEBUG_CODE=

# ─── Database ─────────────────────────────────────────────────────────
# PostgreSQL (рекомендуется). SQLite: USE_SQLITE=True (файл db.sqlite3 в backend/).
USE_SQLITE=False
# Docker (start_postgres.bat): порт 5433. Локальный PostgreSQL: порт 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/chatdb
REDIS_URL=redis://localhost:6379/0

# ─── SMS (RedSMS) ────────────────────────────────────────────────────
REDSMS_LOGIN=
REDSMS_API_KEY=
REDSMS_FROM=Chat

# ─── Payments (YooKassa) ─────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ─── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_SECRET=
# Токен для отправки кодов верификации через официальный бот Telegram (Gateway API).
# Получить: https://gateway.telegram.org/ → войти → Account → API → Copy Token
TELEGRAM_GATEWAY_TOKEN=
